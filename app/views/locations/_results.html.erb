<section class="location-results" aria-live="polite">
  <% if error.present? %>
    <p class="status-message error"><%= error %></p>
  <% elsif query.blank? %>
    <p class="status-message">Enter a US ZIP code to search forecast locations.</p>
  <% elsif search_performed && locations.empty? %>
    <p class="status-message">No matching US ZIP code found for "<%= query %>".</p>
  <% elsif locations.any? %>
    <h2>Matching Locations</h2>
    <ul class="location-list">
      <% locations.each do |location| %>
        <li class="location-result">
          <strong><%= location.display_name %></strong>
          <span>
            <%= number_with_precision(location.latitude, precision: 4) %>,
            <%= number_with_precision(location.longitude, precision: 4) %>
            <% if location.timezone.present? %>
              &middot; <%= location.timezone %>
            <% end %>
          </span>

          <%= form_with url: forecast_path, method: :get, data: { turbo_frame: "_top" }, class: "forecast-selection-form" do %>
            <%= render "forecasts/location_fields", location: location %>
            <%= submit_tag "View forecast" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
